{
  "name": "claude-history",
  "version": "1.5.1",
  "description": "Browse Claude Code conversation history",
  "main": "electron/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloud-mouse/claude-history.git"
  },
  "build": {
    "appId": "com.cloud-mouse.claude-history",
    "productName": "Claude History",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!dist/mac-arm64",
      "!dist/*.dmg",
      "!dist/*.zip",
      "!dist/*.blockmap",
      "!dist/*.yml"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.512x512.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.512x512.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "owner": "cloud-mouse",
      "repo": "claude-history",
      "releaseType": "release"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:release": "vite build && electron-builder --publish always",
    "postinstall": "electron-builder install-app-deps",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.65.0",
    "better-sqlite3": "^11.7.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.10.0",
    "marked": "^18.0.2",
    "pinia": "^2.3.0",
    "smol-toml": "^1.6.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "dompurify": "^3.4.1",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "jest": "^30.3.0",
    "vite": "^6.0.7",
    "vitepress": "^1.6.4"
  }
}
